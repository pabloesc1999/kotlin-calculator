<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Calculator.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="backgroundTint">@color/calc_number_bg</item>
        <item name="android:textColor">@color/calc_number_text</item>
        <item name="cornerRadius">200dp</item>
    </style>

    <style name="Widget.Calculator.ActionButton" parent="Widget.Calculator.Button">
        <item name="backgroundTint">@color/calc_action_bg</item>
        <item name="android:textColor">@color/calc_action_text</item>
    </style>

    <style name="Widget.Calculator.OperatorButton" parent="Widget.Calculator.Button">
        <item name="backgroundTint">@color/calc_operator_bg</item>
        <item name="android:textColor">@color/calc_operator_text</item>
    </style>
</resources>